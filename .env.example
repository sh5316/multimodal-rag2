# ── LLM / 임베딩 API 키 ───────────────────────
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 키를 채우세요.
#   cp .env.example .env   (또는 복사 후 수정)
# .env 는 절대 Git에 커밋하지 마세요.

# OpenAI (요약 LLM / 임베딩)
OPENAI_API_KEY=sk-...

# 이미지 요약에 멀티모달 모델을 쓸 경우 (선택)
# OPENAI_MODEL=gpt-4o-mini

# LangSmith 추적 (선택)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=multimodal-rag
